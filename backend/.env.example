DATABASE_URL=postgresql+psycopg://your_username:your_password@localhost:5432/telosia

# Comma-separated list of origins the API will accept browser requests
# from. Defaults to the frontend's Vite dev server (localhost:5173) if
# this isn't set - only needed once the frontend has a deployed URL.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-deployed-frontend.example

# NVIDIA NIM chatbot. Keep the real key in .env only.
NVIDIA_API_KEY=nvapi-your-api-key
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=openai/gpt-oss-20b
RAG_INDEX_DIRECTORY=knowledge/rag
RAG_MINIMUM_SCORE=0.30
RAG_ALLOW_UNREVIEWED=false