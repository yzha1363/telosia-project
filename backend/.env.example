DATABASE_URL=postgresql+psycopg://your_username:your_password@localhost:5432/telosia

# Comma-separated list of origins the API will accept browser requests
# from. Defaults to the frontend's Vite dev server (localhost:5173) if
# this isn't set - only needed once the frontend has a deployed URL.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-deployed-frontend.example

# Template only. Runtime configuration belongs in backend/.env.
# NVIDIA NIM chatbot. Keep the real key in .env only.
NVIDIA_API_KEY=nvapi-your-api-key
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=z-ai/glm-5.3-flash
# default omits the parameter. Compare low against default using the benchmark
# before enabling it; lower effort is not a guarantee of latency or accuracy.
NVIDIA_CHAT_REASONING_EFFORT=default
# Bounded multi-step database analysis (no database writes).
# Output budget; the application currently clamps this to 512..8192.
NVIDIA_CHAT_MAX_TOKENS=3072
NVIDIA_CHAT_TIMEOUT_SECONDS=60
# Whole analysis budget, including all model rounds and the optional retry.
CHAT_TOTAL_TIMEOUT_SECONDS=240
# Reserve the last 60 seconds for an evidence-only summary; no new queries.
CHAT_SUMMARY_RESERVE_SECONDS=60
# Used only when the user explicitly chooses a longer retry (hard cap 300).
CHAT_EXTENDED_TIMEOUT_SECONDS=300
# Optional shared secret for signed previous-turn metadata across workers.
# Without it receipts are process-local and expire after restart or one hour.
# CHAT_CONTEXT_SIGNING_KEY=generate-a-long-random-secret-for-production
# At most one transient retry per user request, before any partial output.
CHAT_MAX_TRANSIENT_RETRIES=0
CHAT_MAX_ROUNDS=7
CHAT_MAX_TOOL_CALLS=12
# auto: native tool calls, with one JSON-action recovery on malformed protocol.
# native: disable recovery. json: model-selected actions without native tools.
# Both transports use the same read-only tools and validators.
CHAT_TOOL_PROTOCOL=auto
RAG_INDEX_DIRECTORY=knowledge/rag
RAG_MINIMUM_SCORE=0.30
RAG_ALLOW_UNREVIEWED=false
